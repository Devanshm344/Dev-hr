DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/alumni_network
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SSO handoff from cotelligent-hrms — a dedicated secret, distinct from
# AUTH_SECRET above (which signs real end-user sessions). Only used to verify
# short-lived, single-purpose tokens minted by the HRMS backend when an
# Admin/Super Admin clicks the "Alumni" tile. Must match
# ALUMNI_SSO_SHARED_SECRET in cotelligent-hrms/backend/.env exactly.
SSO_SHARED_SECRET=CHANGE_ME_SSO_SHARED_SECRET
ALUMNI_FRONTEND_URL=http://localhost:5174
