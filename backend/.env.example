DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/dev-hr
SECRET_KEY=CHANGE_ME_SECRET_KEY
DEBUG=True
UPLOAD_DIR=uploads

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Install Ollama: https://ollama.com/download
#
# Recommended models (run ONE of these after installing Ollama):
#
#   FAST  (2 GB RAM) — good for RAG, snappy responses:
#     ollama pull llama3.2:3b
#
#   BEST  (5 GB RAM) — better reasoning, lower hallucination:
#     ollama pull llama3.1:8b
#
#   ALT   (4 GB RAM) — very low hallucination, strong for Q&A:
#     ollama pull qwen2.5:7b
#
# After pulling, start the server:  ollama serve
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional — only needed if wiring up SSO with the alumni-network sub-app.
# Must match SSO_SHARED_SECRET in alumni-network/backend/.env exactly.
ALUMNI_SSO_SHARED_SECRET=
